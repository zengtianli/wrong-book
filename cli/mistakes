def phone_verify(c, phone, purpose, sec, request_id=None, password="", identity="", code_env="EDU_SMS_CODE"):
    request_id = request_id or str(uuid.uuid4())
    c.sms_request_id = request_id
    try:
        sent = c.call("api/phone_send", {"phone": phone, "purpose": purpose, "password": password,
                                       "identity_grant": identity, "request_id": request_id})
    except Fail as failure:
        failure.request_id = request_id
        raise
    c.sms_request_id = None
    challenge = sent.get("challenge")
    if not challenge:
        raise Fail("服务端未返回短信挑战编号")
    code = sec.value(code_env, "短信验证码")
    grant = c.call("api/phone_verify", {"challenge": challenge, "code": code}).get("grant")
    if not grant:
        raise Fail("服务端未返回验证授权")
    return grant


def cmd_phone_auth(c, a, sec):
    if a.sub == "phone-register" and not a.agreed:
        raise Fail("先阅读 App 的用户协议与隐私政策；确认同意后加 --agreed", code=2)
    purpose = {"phone-login": "login", "phone-register": "register", "phone-recover": "phone_recover"}[a.sub]
    grant = phone_verify(c, a.phone, purpose, sec, a.request_id)
    body = {"grant": grant, "password": os.environ.get("EDU_PASSWORD", "")}
    if a.sub == "phone-register":
        body["agreed"] = True
    elif a.sub == "phone-recover":
        body["new"] = sec.value("EDU_NEW_PASSWORD", "新密码")
    if getattr(a, "risk_email", None):
        sent = c.call("api/email_send", {"email": a.risk_email, "purpose": "recover"})
        body["email_grant"] = c.call("api/email_verify", {"challenge": sent["challenge"],
            "code": sec.value("EDU_EMAIL_CODE", "独立邮箱验证码")})["grant"]
    r = c.call("api/" + a.sub.replace("-", "_"), body)
    return {"ok": True, **{k: r[k] for k in ("u", "has_password", "message") if k in r}}, lambda: r.get("message", "手机账号操作成功")


def cmd_phone_bind(c, a, sec):
    me = c.call("api/me")
    current = me.get("phone", "") if me.get("phone_verified") else ""
    identity = ""
    password = sec.account() if me.get("has_password", True) else ""
    if not me.get("has_password", True):
        identity = phone_verify(c, current, "phone_identity", sec, a.identity_request_id,
                                code_env="EDU_SMS_IDENTITY_CODE")
    grant = phone_verify(c, a.phone, "phone_change_new" if current else "phone_new", sec,
                         a.request_id, password=password, identity=identity)
    old = phone_verify(c, current, "phone_old", sec, a.old_request_id, password=password,
                       identity=identity, code_env="EDU_SMS_OLD_CODE") if current else ""
    r = c.call("api/phone_bind", {"phone": a.phone, "password": password, "identity_grant": identity,
                                "grant": grant, "old_grant": old})
    return {"ok": True, "message": r.get("message"), "has_password": r.get("has_password")}, lambda: r.get("message", "手机号已保存")


def cmd_password_set(c, a, sec):
    me = c.call("api/me")
    if me.get("has_password", True):
        raise Fail("已有密码，请使用 App 内修改密码或找回流程", code=2)
    grant = phone_verify(c, me.get("phone", ""), "phone_identity", sec, a.request_id,
                         code_env="EDU_SMS_IDENTITY_CODE")
    r = c.call("api/password_set", {"identity_grant": grant, "new": sec.value("EDU_NEW_PASSWORD", "新密码")})
    return {"ok": True, "message": r.get("message")}, lambda: r.get("message", "登录密码已设置")

