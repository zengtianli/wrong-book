    if s.get("state") == "done" and not s.get("result_ok"):
        raise Fail("作业失败：" + (s["log"].strip().splitlines() or ["（无日志）"])[-1])
    return {"ok": True, **s}, lambda: f"已派作业 {jid}（{s['state']}）；用 mistakes job {jid} --wait 60 看结果"


