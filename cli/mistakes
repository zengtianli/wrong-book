def main(argv: list[str]) -> int:
    if argv and argv[0] in APP_VERBS:
        return forward(argv)
    ap = build()
    a = ap.parse_args(argv)
    if getattr(a, "forward", None):
        return forward([a.forward, *a.rest])
    if not getattr(a, "fn", None):
        ap.print_help()
        return 2
    as_json = getattr(a, "json", False)
    sec = Secrets(a)
    try:
        c = (Client(a.api or os.environ.get("EDU_API_BASE") or DEFAULT_API, timeout=a.timeout)
             if getattr(a, "anonymous", False) else session(a, sec))
        v, text = a.fn(c, a, sec)
    except Fail as f:
        if as_json:
            retry = getattr(f, "request_id", None) or getattr(locals().get("c"), "sms_request_id", None)
            print(json.dumps(fail_json(f.msg, f.code, f.status, retry), ensure_ascii=False))
        else:
            print(f"✘ {f.msg}", file=sys.stderr)
        return f.code
    except OSError as e:
        msg = f"读写本地文件失败：{e}"
        print(json.dumps(fail_json(msg), ensure_ascii=False) if as_json else f"✘ {msg}",
              file=sys.stdout if as_json else sys.stderr)
        return 1
    if as_json:
        print(json.dumps(v, ensure_ascii=False, indent=1))
    else:
        print(text())
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
