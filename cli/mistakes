def _json_obj(raw):
    try:
        o = json.loads(raw) if isinstance(raw, str) else None
    except ValueError:
        return None
    return o if isinstance(o, dict) else None


def _int(x, default=0):
    return x if isinstance(x, int) and not isinstance(x, bool) else default


def cmd_wrongs(c, a, sec):
    """同 WrongBook.parse：edu:<slug>.wrong[] 只认 gid/gname/q/at/wrong/ok/manual/hits，
    不读 ans/options（结构上就不留原题重放的后路）；顺序跟课程清单走。"""
    (arch, ts), man = _archive(c), c.call("api/lessons")
    lessons = man.get("lessons") or []
    by_slug = {x.get("slug"): x for x in lessons}
    order = {x.get("slug"): i for i, x in enumerate(lessons)}
    groups, orphans = [], []
    for key, raw in arch.items():
        if not key.startswith("edu:") or key.startswith("edu:@"):
            continue
        slug, o = key[4:], _json_obj(raw)
        if not o:
            continue
        entries = []
        for j in o.get("wrong") or []:
            if not isinstance(j, dict) or not isinstance(j.get("gid"), str) or not j["gid"]:
                continue
            hits = [{"q": h.get("q") or "", "at": h.get("at") or "",
                     "no": str(h["no"]) if isinstance(h.get("no"), (str, int)) and not isinstance(h.get("no"), bool) else "",
                     "src": h.get("src") or ""}
                    for h in (j.get("hits") or []) if isinstance(h, dict) and h.get("q")]
            entries.append({"gid": j["gid"], "gname": j.get("gname") or "错题", "q": j.get("q") or "",
                            "at": j.get("at") or "", "wrong": _int(j.get("wrong")), "ok": _int(j.get("ok")),
                            "manual": _int(j.get("manual")) != 0, "hits": hits})
        if not entries:
            continue
        lesson = by_slug.get(slug)
        if lesson is None:
            orphans.append(slug)
        groups.append({"slug": slug, "title": (lesson or {}).get("title") or slug,
                       "subject": (lesson or {}).get("subject") or "", "in_manifest": lesson is not None,
                       "entries": entries})
    if a.subject:
        groups = [g for g in groups if g["subject"] == a.subject]
    if a.search:
        t = a.search.lower()
        for g in groups:
            g["entries"] = [e for e in g["entries"] if t in (e["gname"] + e["q"] + g["title"]).lower()
                            or any(t in h["q"].lower() for h in e["hits"])]
        groups = [g for g in groups if g["entries"]]
    groups.sort(key=lambda g: (order.get(g["slug"], 1 << 30), g["slug"]))
    v = {"ok": True, "source": "server_archive_snapshot", "archive_ts": ts or None,
         "lessons": len(groups), "types": sum(len(g["entries"]) for g in groups),
         "orphan_slugs": sorted(orphans), "groups": groups}
    def text():
        out = []
        for g in groups:
            out.append(f"■ {g['title']}（{len(g['entries'])} 类）" + ("" if g["in_manifest"] else "  [课程包里已没有这一课]"))
            for e in g["entries"]:
                prog = f" · 已订正 {e['ok']}/2" if e["ok"] else ""
                out.append(f"   {e['gname']}：{'手动收进' if e['manual'] and not e['wrong'] else '错 %d 次' % e['wrong']}{prog}"
                           + (f" —— {e['q']}" if e["q"] else ""))
        return "\n".join(out) or "（服务器存档里没有错题）"
    return v, text


def _plain(html: str) -> str:
    """同 QuestionIndex.plain：去标签、还原常见实体、压空白。"""
    text = re.sub(r"<[^>]+>", " ", html)
    for src, dst in (("&lt;", "<"), ("&gt;", ">"), ("&quot;", '"'), ("&#x27;", "'"), ("&#39;", "'"), ("&nbsp;", " "),
                     ("&amp;", "&")):
        text = text.replace(src, dst)
    return re.sub(r"\s+", " ", text).strip()


def _lesson_items(html: str):
    """同 QuestionIndex.parse：只读练习页 PRACTICE.init(… items: [...]) 里的 uid / gid / q / ask / own，
    不读答案与选项。认不出题目数组时返回 None（App 把这样的课显示成一行「练习资料」）。"""
    i = html.rfind("PRACTICE.init(")
    j = html.find("items:", i + 14) if i >= 0 else -1
    start = html.find("[", j + 6) if j >= 0 else -1
    if start < 0:
        return None
    quoted = escaped = False
    depth, end = 0, -1
    for k in range(start, len(html)):
        ch = html[k]
        if quoted:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                quoted = False
        elif ch == '"':
            quoted = True
        elif ch == "[":
            depth += 1
        elif ch == "]":
            depth -= 1
            if depth == 0:
                end = k + 1
                break
    if end < 0:
        return None
    try:
        rows = json.loads(html[start:end])
    except ValueError:
        return None
    if not isinstance(rows, list) or not all(isinstance(r, dict) for r in rows):
        return None
    private = re.search(r"privateItems:\s*true", html[end:]) is not None
    out = []
    for r in rows:
        uid, q = r.get("uid"), r.get("q")
        if not (isinstance(uid, str) and uid and isinstance(q, str) and q and (private or r.get("own") == 1)):
            continue
        ask = r.get("ask") if isinstance(r.get("ask"), str) else ""
        gid = "photo:" + uid if private else (r.get("gid") if isinstance(r.get("gid"), str) else "")
        out.append({"uid": uid, "gid": gid, "text": _plain(q + (" " + ask if ask else "")), "private": private})
    return out


def cmd_questions(c, a, sec):
    """同 App 的错题本 / 复习列表（FocusLibraryView + QuestionIndex）：课程包里的每道原题一行；
    「待巩固」= 存档里同一课有同 gid 的错题类型。直读服务端课程包与存档，不经 App 的本机副本。"""
    (arch, ts), man = _archive(c), c.call("api/lessons")
    pending = {}
    for key, raw in arch.items():
        if key.startswith("edu:") and not key.startswith("edu:@"):
            pending[key[4:]] = {j["gid"] for j in (_json_obj(raw) or {}).get("wrong") or []
                                if isinstance(j, dict) and isinstance(j.get("gid"), str) and j["gid"]}
    items, bare = [], []
    for x in man.get("lessons") or []:
        if not x.get("file") or (a.subject and x.get("subject") != a.subject):
            continue
        rows = _lesson_items(c.raw("api/lesson", {"file": x["file"]}).decode("utf-8", "replace"))
        lesson = {"slug": x.get("slug") or "", "title": x.get("title") or "", "subject": x.get("subject") or "",
                  "subject_name": x.get("subject_name") or ""}
        if not rows:
            bare.append({**lesson, "pending": bool(pending.get(lesson["slug"]))})
            continue
        items += [{**lesson, **r, "pending": r["gid"] in pending.get(lesson["slug"], ())} for r in rows]
    if a.pending:
        items, bare = [i for i in items if i["pending"]], [b for b in bare if b["pending"]]
    if a.search:
        t = a.search.lower()
        items = [i for i in items if t in (i["text"] + i["title"] + i["subject_name"]).lower()]
        bare = [b for b in bare if t in b["title"].lower()]
    v = {"ok": True, "source": "lesson_pack", "archive_ts": ts or None, "count": len(items),
         "pending": sum(1 for i in items if i["pending"]), "items": items, "lessons_without_items": bare}
    def text():
        out = [f"{i['subject_name'] or i['subject']} · {i['text']}  —— {i['title']}" + ("  [待巩固]" if i["pending"] else "")
               for i in items]
        out += [f"{b['subject_name'] or b['subject']} · {b['title']}  [练习资料：打开查看题目]" for b in bare]
        return "\n".join(out) or ("（没有待巩固的题）" if a.pending else "（课程包里还没有题目：先导入错题图片）")
    return v, text


