    return v, lambda: "\n".join(f"{x['id']}  {x.get('status')}  {x.get('subject', '')}  {x.get('job_state', '')}"
                                f"{'（' + x['note'] + '）' if x.get('note') else ''}" for x in items) or "（没有上传过错题照片）"


def cmd_papers(c, a, sec):
    r = c.call("api/papers")
    items = [{"slug": x.get("slug"), "status": x.get("status"), "pages": sorted((x.get("pages") or {}), key=int),
              "created": x.get("created"), "updated": x.get("updated"), "note": x.get("note") or ""}
             for x in r.get("items") or []]
    v = {"ok": True, "total": len(items), "pending": r.get("pending", 0), "items": items}
    return v, lambda: "\n".join(f"{x['slug']}  {x['status']}  第 {','.join(x['pages'])} 页" for x in items) or "（没有整卷批次）"


def _job_state(c, jid: str) -> dict:
    r = c.call("api/job", query={"id": jid})
    if r.get("state") != "done":
        return {"job": jid, "state": "running"}
    res = r.get("res") or {}
    return {"job": jid, "state": "done", "result_ok": bool(res.get("ok")), "log": str(res.get("log") or "")}


def _wait(c, jid: str, seconds: float) -> dict:
    end = time.monotonic() + max(0.0, seconds)
    while True:
        s = _job_state(c, jid)
        if s["state"] == "done" or time.monotonic() >= end:
            return s
        time.sleep(3)


def cmd_job(c, a, sec):
    s = _wait(c, a.job_id, a.wait or 0)
    if s["state"] == "done" and not s["result_ok"]:
        raise Fail("作业失败：" + (s["log"].strip().splitlines() or ["（无日志）"])[-1])
    return {"ok": True, **s}, lambda: (f"{a.job_id}：{'完成' if s['state'] == 'done' else '进行中'}"
                                       + (f"\n{s['log'].strip()}" if s.get("log") else ""))


