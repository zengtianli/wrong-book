    """同 practice.js 的 today() / GrowthProfile.todayStamp：月/日不补零（2026-8-9）。"""
    d = d or date.today()
    return f"{d.year}-{d.month}-{d.day}"


def cmd_progress(c, a, sec):
    """同 GrowthProfile.parse：跨天后今日已做按 0 算；只给原始 xp，不在这里另算等级。"""
    arch, ts = _archive(c)
    o = _json_obj(arch.get("edu:@profile")) or {}
    day, days = o.get("day") if isinstance(o.get("day"), dict) else {}, o.get("days") if isinstance(o.get("days"), dict) else {}
    today = today_stamp()
    done = _int(day.get("n")) if day.get("d") == today else 0
    goal = _int(o.get("goal"), 12)
    v = {"ok": True, "source": "server_archive_snapshot", "archive_ts": ts or None,
         "has_profile": bool(o), "today": today, "done_today": done, "goal": goal,
         "remaining": max(0, goal - done), "xp": _int(o.get("xp")), "streak_days": _int(days.get("streak"))}
    return v, lambda: (f"今天 {done}/{goal} 题（还差 {v['remaining']}）· 经验 {v['xp']} · 连续 {v['streak_days']} 天"
                       if o else "服务器存档里还没有学习进度")


