class Client:
    def __init__(self, base: str, timeout: float = 20):
        self.base = base.rstrip("/")
        self.timeout = timeout
        self.op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(CookieJar()))

    def _open(self, path, body, query, timeout):
        url = f"{self.base}/{path.lstrip('/')}"
        if query:
            url += "?" + urllib.parse.urlencode(query)
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(url, data=data, method="POST" if body is not None else "GET",
                                     headers={"Content-Type": "application/json", "User-Agent": AGENT})
        try:
            with self.op.open(req, timeout=timeout or self.timeout) as r:
                return r.status, r.read(), r.headers.get("Content-Type") or ""
        except urllib.error.HTTPError as e:
            return e.code, e.read(), e.headers.get("Content-Type") or ""
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            raise Fail(f"连不上 {self.base}：{getattr(e, 'reason', e)}")

    def call(self, path: str, body: dict | None = None, query: dict | None = None,
             timeout: float | None = None) -> dict:
        status, payload, _ = self._open(path, body, query, timeout)
        try:
            obj = json.loads(payload or b"{}")
        except ValueError:
            raise Fail(f"服务端返回的不是 JSON（HTTP {status}）", status=status)
        if status >= 400 or obj.get("ok") is False:
            err = Fail(str(obj.get("err") or f"HTTP {status}"), status=status)
            err.code_name = obj.get("code")
            raise err
        return obj

    def raw(self, path: str, query: dict | None = None) -> bytes:
        status, payload, ctype = self._open(path, None, query, None)
        if status >= 400 or ctype.startswith("application/json"):
            try:
                err = json.loads(payload).get("err")
            except ValueError:
                err = None
            raise Fail(str(err or f"HTTP {status}"), status=status)
        return payload


class Secrets:
    def __init__(self, args):
        self.args = args
        self._account: str | None = None

    def account(self) -> str:
        if self._account is None:
            if getattr(self.args, "password_stdin", False):
                lines = [sys.stdin.readline().rstrip("\r\n")] if not sys.stdin.isatty() else []
                if not lines:
                    raise Fail("stdin 里缺少账号密码（一行）", code=2)
                self._account = lines[0]
            else:
                self._account = os.environ.get("EDU_PASSWORD") or ""
                if not self._account:
                    raise Fail("缺账号密码：设 EDU_PASSWORD 或用 --password-stdin", code=2)
        return self._account

    def value(self, env: str, label: str) -> str:
        value = os.environ.get(env)
        if value is not None:
            return value
        if sys.stdin.isatty():
            return getpass.getpass(label + ": ")
        value = sys.stdin.readline().rstrip("\r\n")
        if not value:
            raise Fail(f"缺少{label}：使用交互输入或受保护环境变量 {env}", code=2)
        return value


