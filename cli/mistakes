        _need_consent(a)
    pages = []
    for i, f in enumerate(a.images):
        body = {"slug": slug, "page": a.first_page + i, "note": a.note or "", "data": _dataurl(f)}
        if a.no_auto:
            body["auto"] = False               # 服务端的自检通道：只存页，不读图、不占额度
        r = c.call("api/paper_page", body, timeout=90)
        p = {"file": Path(f).name, "page": a.first_page + i, "wrong_id": r.get("wrong_id"), "job": r.get("job")}
        if r.get("auto_err"):
            p["auto_err"] = r["auto_err"]
        if p["job"] and a.wait:
            p.update(_wait(c, p["job"], a.wait))
        pages.append(p)
    v = {"ok": True, "slug": slug, "count": len(pages), "pages": pages}
    return v, lambda: f"卷子 {slug}：传了 {len(pages)} 页\n" + "\n".join(
        f"  第 {p['page']} 页 {p['file']}" + (f" · 作业 {p['job']}" if p.get("job") else "")
        + (f" · {p['auto_err']}" if p.get("auto_err") else "") for p in pages)


def cmd_recognize(c, a, sec):
    """同 wrong.html「开始 / 重试识别」：派 /api/wrong_job。commit 写进本账号的个人课程包（不是共享题库）。"""
    if a.kind in ("auto", "draft"):
        _need_consent(a)
    body = {"kind": a.kind, "id": a.upload_id}
    if a.kind == "commit":
        if not a.topic:
            raise Fail("commit 要 --topic <知识点 slug>", code=2)
        body["topic"] = a.topic
        if a.gen:
            body["gen"] = a.gen
        if a.dup_ok:
            body["dup_ok"] = True
    jid = c.call("api/wrong_job", body).get("job")
    s = _wait(c, jid, a.wait) if a.wait else {"job": jid, "state": "queued"}
    if s.get("state") == "done" and not s.get("result_ok"):
        raise Fail("作业失败：" + (s["log"].strip().splitlines() or ["（无日志）"])[-1])
    return {"ok": True, **s}, lambda: f"已派作业 {jid}（{s['state']}）；用 mistakes job {jid} --wait 60 看结果"


