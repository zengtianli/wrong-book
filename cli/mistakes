def _dataurl(path: str) -> str:
    blob = Path(path).read_bytes()
    if not blob:
        raise Fail(f"{path} 是空文件", code=2)
    # mime 前缀只是标签，服务端从真实字节认格式（同 wrong.html：不在客户端预筛格式）
    return "data:application/octet-stream;base64," + base64.b64encode(blob).decode()


def _need_consent(a):
    if not a.consent_ai:
        raise Fail("这一步会把图片发给 DeepSeek 做 AI 识别并占用识别额度：同意请加 --consent-ai"
                   "（同 App/网页的识别同意勾选）", code=2)


def cmd_upload(c, a, sec):
    """同 wrong.html：一张一张传 /api/wrong，默认紧接着派 auto 读图作业。"""
    if not a.no_auto:
        _need_consent(a)
    out = []
    for f in a.images:
        r = c.call("api/wrong", {"data": _dataurl(f), "subject": a.subject or "", "note": a.note or ""}, timeout=90)
        item = {"file": Path(f).name, "id": r["item"]["id"]}
        if not a.no_auto:
            item["job"] = c.call("api/wrong_job", {"kind": "auto", "id": item["id"]}).get("job")
            if a.wait:
                item.update(_wait(c, item["job"], a.wait))
        out.append(item)
    v = {"ok": True, "count": len(out), "items": out}
    return v, lambda: "\n".join(f"{x['file']} → {x['id']}" + (f" · 作业 {x['job']}" if x.get("job") else "")
                                + (f" · {x['state']}" if x.get("state") else "") for x in out)


def paper_slug(a) -> str:
    if a.slug:
        slug = a.slug
    else:
        if not (a.year and a.term and a.grade and a.subject and a.kind):
            raise Fail("给 --slug，或同时给 --year --term --grade --subject --kind 拼卷子编号", code=2)
        slug = f"{a.year}s{a.term}-g{a.grade}-{a.subject}-{a.kind}"   # 同 PaperScan.Slug.text
    if not PAPER_SLUG_RE.match(slug):
        raise Fail(f"卷子编号不对：{slug}（形如 2026s1-g3-math-final）", code=2)
    return slug


