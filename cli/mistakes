    if not user and not getattr(args, "sms_phone", None):
        raise Fail("缺账号：设 EDU_USER 或用 --user", code=2)
    c = Client(args.api or os.environ.get("EDU_API_BASE") or DEFAULT_API, timeout=args.timeout)
    if getattr(args, "sms_phone", None):
