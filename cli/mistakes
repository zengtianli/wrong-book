IMAGE_EXT = {b"\x89PNG": ".png", b"\xff\xd8\xff": ".jpg", b"RIFF": ".webp", b"GIF8": ".gif"}


def cmd_image(c, a, sec):
    """同 wrong.html 的原图 / PaperScan 的页面预览：把自己上传的一张原图存到本地文件（只拿自己的）。"""
    if a.what == "upload":
        blob = c.raw("api/wrong_img", {"id": a.target})
        stem = a.target
    else:
        if a.page is None:
            raise Fail("paper 要 --page 第几页", code=2)
        blob = c.raw("api/paper_img", {"slug": a.target, "page": a.page})
        stem = f"{a.target}-p{a.page}"
    ext = next((e for sig, e in IMAGE_EXT.items() if blob.startswith(sig)), ".bin")
    out = Path(a.out or stem + ext)
    out.write_bytes(blob)
    v = {"ok": True, "what": a.what, "target": a.target, "page": a.page, "path": str(out.resolve()), "bytes": len(blob)}
    return v, lambda: f"已保存 {v['path']}（{len(blob)} 字节；是本人上传的原图，请妥善保管）"


