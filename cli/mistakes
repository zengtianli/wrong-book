class Parser(argparse.ArgumentParser):
    """参数写错时，带 --json 也输出 {"ok": false, …}（退出码仍是 2）；不带 --json 照 argparse 原样。"""

    def error(self, message):
        if "--json" in sys.argv[1:]:
            print(json.dumps(fail_json(f"用法错误：{message}", 2), ensure_ascii=False))
            raise SystemExit(2)
        super().error(message)


def fail_json(msg: str, code: int = 1, status: int | None = None, request_id: str | None = None) -> dict:
    """失败输出：原有的 err / status / request_id 不变，另带约定的 error: {code, message}。"""
    return {"ok": False, "err": msg, "error": {"code": "usage" if code == 2 else "rejected" if status else "failed",
                                                 "message": msg},
            **({"status": status} if status else {}), **({"request_id": request_id} if request_id else {})}


