    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos of mistakes and, after you confirm, upload them to your personal learning library for recognition and review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄错题照片，确认后上传到你自己的学习库用于识别和复习。"
          }
        }
      }
    },
