    "App Store 暂未返回订阅方案，请稍后重试。已有免费额度仍可使用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store hasn't returned any subscription plans yet. Try again later. You can still use your remaining free allowance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 暂未返回订阅方案，请稍后重试。已有免费额度仍可使用。"
          }
        }
      }
    },
    "App 不预装个人资料。登录后可导入自己的错题照片；已同步的个人课程支持离线练习。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app comes with no personal materials. Log in to import photos of your mistakes. Synced lessons are available for offline practice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不预装个人资料。登录后可导入自己的错题照片；已同步的个人课程支持离线练习。"
          }
        }
      }
    },
    "Apple 购买验证未通过，请恢复购买重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't verify this purchase. Try Restore Purchases."
