    "+86 家长手机号；短信签名「{sign}」，有效{minutes}分钟。收不到可等待重发或改用邮箱。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the parent’s mainland China number (+86). Text messages show “{sign}”; codes expire in {minutes} minutes. If no code arrives, wait to resend or use email."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "+86 家长手机号；短信签名「{sign}」，有效{minutes}分钟。收不到可等待重发或改用邮箱。"
          }
        }
      }
    },
