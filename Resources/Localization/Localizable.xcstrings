    "15–128 个字符，允许空格和中文。可使用系统生成密码或独特短语。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 15–128 characters. Spaces and Chinese characters are allowed. You can use a system-generated password or a unique passphrase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "15–128 个字符，允许空格和中文。可使用系统生成密码或独特短语。"
          }
        }
      }
    },
